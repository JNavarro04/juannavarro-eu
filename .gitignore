node_modules
dist
.DS_Store
*.local
.vercel

# Source photography — 1.2GB of originals. Build inputs only, never deployed.
photos-src/

# Generated derivatives ARE committed (57MB). They have to be: the 1.2GB of
# originals in photos-src/ is not in the repo, so a CI build cannot regenerate
# them. Without these the deployed site has no photographs at all.
# Rebuild locally with `npm run assets` when the photo set changes.

# Secrets
.env
.env.local
.env*.local

# Agent scratch harnesses — never committed
*-lab.html
*-lab.ts
*-check.html

# graphify code graph — regenerated in seconds at zero token cost with
# `graphify update .`, so it is rebuilt rather than tracked. Un-ignore it if you
# want a clone to arrive with the graph already built.
graphify-out/
